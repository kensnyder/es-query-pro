{
  "name": "es-query-pro",
  "version": "3.0.0-beta.2",
  "description": "Simple and powerful ElasticSearch query builder and index manager",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "ElasticSearch",
    "es",
    "query",
    "query builder",
    "es query builder",
    "Elasticsearch query builder"
  ],
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test .spec.ts",
    "test:integration": "bun test .integration.test.ts",
    "test:import": "bun run build && bun run import-test.ts",
    "test-watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "coverage-lcov": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "format:check": "biome check .",
    "build": "bun run build:clean && bun run build:dts && bun run build:esm && bun run build:gzip-size",
    "build:clean": "rm -Rf dist/ && mkdir dist && touch dist/.gitkeep",
    "build:dts": "bunx dts-bundle-generator --no-check --project tsconfig.bundle-generator.json -o dist/index.d.ts ./index.ts",
    "build:esm": "bunx esbuild ./index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.mjs",
    "build:gzip-size": "echo 'gzipped savings and size:' && gzip -cv dist/index.mjs | wc -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensnyder/es-query-pro.git"
  },
  "author": "Ken Snyder",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kensnyder/es-query-pro/issues"
  },
  "homepage": "https://github.com/kensnyder/es-query-pro#readme",
  "dependencies": {
    "type-fest": "4.41.0"
  },
  "peerDependencies": {
    "@elastic/elasticsearch": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@elastic/elasticsearch": "9.5.1",
    "bun-types": "1.4.5",
    "dts-bundle-generator": "10.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
