{
  "name": "es-query-pro",
  "version": "3.0.0-beta.2",
  "description": "Simple and powerful ElasticSearch query builder and index manager",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "keywords": [
    "ElasticSearch",
    "es",
    "query",
    "query builder",
    "es query builder",
    "Elasticsearch query builder"
  ],
  "scripts": {
    "test": "bun test",
    "test-watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "coverage-lcov": "bun test --coverage --coverage-reporter=lcov",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "format:check": "biome check .",
    "build": "bun run build:clean && bun run build:dts:link && bun run build:dts && bun run build:esm && bun run build:cjs && bun run build:gzip-size",
    "build:clean": "rm -Rf dist/ && mkdir dist && touch dist/.gitkeep",
    "build:dts:link": "mkdir -p node_modules/dts-bundle-generator/node_modules && ln -sfn ../../typescript-5 node_modules/dts-bundle-generator/node_modules/typescript",
    "build:dts": "yes | bunx dts-bundle-generator --project tsconfig.bundle-generator.json -o dist/index.d.ts ./index.ts",
    "build:esm": "bunx esbuild ./index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.mjs",
    "build:gzip-size": "echo 'gzipped savings and size:' && gzip -cv dist/index.mjs | wc -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensnyder/es-query-pro.git"
  },
  "author": "Ken Snyder",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kensnyder/es-query-pro/issues"
  },
  "homepage": "https://github.com/kensnyder/es-query-pro#readme",
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "bun-types": "1.2.20",
    "type-fest": "4.41.0",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
