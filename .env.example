# Copy this file to .env and fill in your Elasticsearch connection values.
# Bun loads .env automatically, so `bun test` will pick these up.
#
# These variables are used by the test suite only (getTestClient() in
# src/testFixtures/testClient.ts). The library itself reads no connection
# settings: applications create their own Client and pass it to IndexManager.

# URL of the Elasticsearch server
ES_ENDPOINT=http://localhost:9200

# Authenticate with an API key...
ES_API_KEY=

# ...or with basic auth (ignored when ES_API_KEY is set)
ES_USERNAME=
ES_PASSWORD=

# Set to true if the server is Elastic Cloud Serverless, so the library skips
# APIs serverless does not support (e.g. _flush) without sending a request.
# This one is also read by the library (IndexManager.isServerless()).
ES_SERVERLESS=false
